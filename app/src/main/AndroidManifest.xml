<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="internalOnly">

    <!-- The performance overlay's readings (CMF Phone 1), kept by a service; System UI draws it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The debug report's buzzes when capturing starts and when it is saved. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only for Nothing Gaming Space's game artwork from SteamGridDB, which is off unless
         turned on and given the user's own API key (see SteamGridArt). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Nothing Gaming Space's "Nothing Gaming Space" folder at the top of the storage
         (GamingStorage): granted by the user in Settings, All files access. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Home apps, to pick the gaming launcher from. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Nothing Gaming Space's categories: browsers, and apps made for TV screens too. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <!-- Nothing's widgets app, which carries Nothing's fonts (see SystemFont). -->
        <package android:name="com.nothing.hearthstone" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Nothing2Something"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription"
            android:value="Nothing Launcher and Nothing OS: drawer folders with dot-matrix covers, landscape home and lock screen, controllers, status bar and more" />
        <meta-data android:name="xposedminversion" android:value="93" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />
        <meta-data android:name="xposedsharedprefs" android:value="true" />

        <!-- The module's settings. LSPosed opens it from its module list (MODULE_SETTINGS), the
             Settings row and Settings search open it too, and none of them goes through the app
             icon below, so it stays reachable while the icon is hidden. -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- The app icon, on its own so "Show app icon" can switch it off (AppIcon) without
             touching the settings above. Its name is the settings activity's name before 0.67.0
             on purpose: a home-screen icon points at this exact name, and Nothing Launcher
             removes a home-screen icon whose name no longer exists (PackageUpdatedTask,
             "Removing shortcut that no longer points to valid component"). -->
        <activity-alias
            android:name=".ui.MainActivity"
            android:targetActivity=".ui.SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Nothing Gaming Space: a home screen for playing with a controller. It is a home
             app (so it can be picked as the gaming launcher that ControllerHome makes Android's
             home while a controller is connected), always in landscape, kept out of recents. -->
        <activity
            android:name=".ui.GamingSpaceActivity"
            android:exported="true"
            android:label="Nothing Gaming Space (alpha) (demo)"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Nothing2Something's row on the Settings home page, first in Nothing's group with
             Intelligence toolkit, Lock screen and Customisation: a standard Settings tile
             (Settings shows it once the module marks it as accepted there: SettingsTile). -->
        <activity-alias
            android:name=".SettingsTile"
            android:targetActivity=".ui.SettingsActivity"
            android:exported="true"
            android:icon="@drawable/ic_settings_eyes"
            android:label="Nothing2Something">
            <intent-filter>
                <action android:name="com.android.settings.action.EXTRA_SETTINGS" />
            </intent-filter>
            <meta-data android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data android:name="com.android.settings.group_key"
                android:value="top_level_nt_custom_category" />
            <meta-data android:name="com.android.settings.order" android:value="-1000" />
            <meta-data android:name="com.android.settings.title" android:value="Nothing2Something" />
            <meta-data android:name="com.android.settings.icon"
                android:resource="@drawable/ic_settings_eyes" />
        </activity-alias>

        <!-- Opened from the launcher's long-press "Edit" item on a custom folder. -->
        <activity
            android:name=".ui.FolderActivity"
            android:exported="true" />

        <activity android:name=".ui.EmojiPickerActivity" />

        <!-- A custom folder's apps: icons, search, Nothing look. -->
        <activity
            android:name=".ui.AppPickerActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Opens Developer options' Running services (tile, shortcuts); shows nothing. -->
        <activity
            android:name=".ui.RunningServices"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="Running services"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Listed where launchers offer shortcuts, as Settings' own "Settings shortcut". -->
        <activity
            android:name=".ui.RunningServices$CreateShortcut"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Running services"
            android:icon="@drawable/ic_running_services"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".ui.RunningServicesTile"
            android:exported="true"
            android:label="Running services"
            android:icon="@drawable/ic_running_services"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Exported for Nothing's Game Bar, which starts it (the system may, while the module is
             in the background); it only shows or hides the module's own overlay. -->
        <service
            android:name=".perf.OverlayService"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Performance overlay: CPU / GPU clocks and temperatures over games" />
        </service>

        <!-- Shows while a debug report runs (buzzes, a countdown notification, a REC pill). -->
        <service
            android:name=".ui.CaptureIndicator"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows when a debug report the user started is capturing" />
        </service>

        <!-- The module's options in Nothing's Game Bar ask this; it listens to the system only. -->
        <receiver
            android:name=".perf.GameBarReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.dressence.nothinglauncherplus.GAME_BAR" />
            </intent-filter>
        </receiver>

        <!-- Restarts Nothing Launcher after an update so the new hooks load without a reboot. -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Read-only cover images for the launcher, which cannot read this app's files. -->
        <provider
            android:name=".CoverProvider"
            android:authorities="com.dressence.nothinglauncherplus.covers"
            android:exported="true" />

        <!-- The module's settings for Nothing's Settings search (search/SearchIndexProvider):
             Settings Intelligence reads every provider answering this action and protected by
             READ_SEARCH_INDEXABLES, which only it holds. -->
        <provider
            android:name=".search.SearchIndexProvider"
            android:authorities="com.dressence.nothinglauncherplus.search"
            android:exported="true"
            android:grantUriPermissions="true"
            android:multiprocess="false"
            android:permission="android.permission.READ_SEARCH_INDEXABLES">
            <intent-filter>
                <action android:name="android.content.action.SEARCH_INDEXABLES_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
